#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0 - QWERTY (giống layout nhà sản xuất)
        layer0 {
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp GRAVE
&kp ESC    &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
&kp TAB    &kp A     &kp S     &kp D     &kp F     &kp G        &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B        &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSFT
&kp C_MUTE &kp LGUI  &kp LALT  &kp LCTRL &mo 1     &kp SPACE    &kp SPACE &kp ENTER &mo 2     &kp MINUS &kp EQUAL &kp RGUI
            >;
            display-name = "QWERTY";
        };

        // Layer 1 - LOWER (kích hoạt bằng phím trái)
        layer_1 {
            bindings = <
&trans     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5       &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp F12
&trans     &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCN     &kp CIRC  &kp AMPS  &kp ASTR  &kp LPAR  &kp RPAR  &kp PIPE
&trans     &kp EQUAL &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC     &kp LBKT  &kp RBKT  &kp SEMI  &kp COLON &kp BSLH  &trans
&trans     &trans    &trans    &trans    &trans    &kp LS(SPACE)&trans    &trans    &trans    &trans    &trans    &trans
            >;
            display-name = "LOWER";
        };

        // Layer 2 - RAISE (kích hoạt bằng phím phải)
        layer_2 {
            bindings = <
&trans     &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans
&trans     &kp INS   &kp PSCR  &kp APP   &trans    &trans       &kp PG_UP &kp C(LEFT) &kp UP  &kp C(RIGHT) &kp C(BSPC) &kp BSPC
&trans     &kp LALT  &kp LCTRL &kp LSHFT &trans    &kp CAPS     &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT &kp DEL   &kp BSPC
&trans     &kp C(Z)  &kp C(X)  &kp C(C)  &kp C(V)  &trans       &kp EQUAL &kp HOME  &kp ASTR  &kp END   &kp PRCN  &trans
&trans     &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans
            >;
            display-name = "RAISE";
        };
    };
};
