#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
// -------------------------------------------------------------------------------------
// | `  | 1  | 2  | 3  | 4  | 5  |                | 6  | 7  | 8  | 9  | 0  | `      |
// | Esc | Q  | W  | E  | R  | T  |                | Y  | U  | I  | O  | P  | Bspc   |
// | Tab | A  | S  | D  | F  | G  |                | H  | J  | K  | L  | ;  | '      |
// |Shift| Z  | X  | C  | V  | B  | Mute |        | N  | M  | ,  | .  | /  | Shift  |
//             | GUI | Alt | Ctrl | Lower | Enter |        | Space | Raise | -  | =  | GUI |
&kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                  &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp GRAVE
&kp ESC    &kp Q     &kp W     &kp E     &kp R     &kp T                   &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
&kp TAB    &kp A     &kp S     &kp D     &kp F     &kp G                   &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B     &kp C_MUTE    &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSFT
                &kp LGUI &kp LALT &kp LCTRL &mo 1      &kp ENTER             &kp SPACE  &mo 2      &kp MINUS  &kp EQUAL &kp RGUI
            >;
        };

        lower_layer {
            bindings = <
// -------------------------------------------------------------------------------------
// |    | F1 | F2 | F3 | F4 | F5 |                | F6 | F7 | F8 | F9 | F10| F11    |
// | `  | 1  | 2  | 3  | 4  | 5  |                | 6  | 7  | 8  | 9  | 0  | F12    |
// |    | !  | @  | #  | $  | %  |                | ^  | &  | *  | (  | )  | |      |
// |    | =  | -  | +  | {  | }  |      |        | [  | ]  | ;  | :  | \  |        |
//             |    |    |    |    |      |        | Shift+Space |    |    |    |    |
&trans     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                  &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                  &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp F12
&trans     &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCN                &kp CIRC  &kp AMPS  &kp ASTR  &kp LPAR  &kp RPAR  &kp PIPE
&trans     &kp EQUAL &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC  &trans       &kp LBKT  &kp RBKT  &kp SEMI  &kp COLON &kp BSLH  &trans
                &trans   &trans   &trans   &trans    &trans                  &kp LS(SPACE) &trans   &trans   &trans   &trans
            >;
        };

        raise_layer {
            bindings = <
// -------------------------------------------------------------------------------------
// |    |    |    |    |    |    |                |    |    |    |    |    |        |
// |    |Ins |Pscr|Menu|    |    |                |PgUp|Prev| Up |Next|Del | Bspc   |
// |    |Alt |Ctrl|Shft|    |Caps|                |PgDn|Left|Down|Rght|Del | Bspc   |
// |    |Undo| Cut|Copy|Paste|   |      |        | =  |Home| *  |End | %  |        |
//             |    |    |    |    |      |        |    |    |    |    |    |
&trans     &trans    &trans    &trans    &trans    &trans                  &trans    &trans    &trans    &trans    &trans    &trans
&trans     &kp INS   &kp PSCR  &kp APP   &trans    &trans                  &kp PG_UP &kp C(LEFT) &kp UP   &kp C(RIGHT) &kp DEL   &kp BSPC
&trans     &kp LALT  &kp LCTRL &kp LSHFT &trans    &kp CAPS                &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT &kp DEL   &kp BSPC
&trans     &kp C(Z)  &kp C(X)  &kp C(C)  &kp C(V)  &trans    &trans        &kp EQUAL &kp HOME  &kp ASTR  &kp END   &kp PRCN  &trans
                &trans   &trans   &trans   &trans    &trans                  &trans    &trans   &trans   &trans   &trans
            >;
        };

        adjust_layer {
            bindings = <
// -------------------------------------------------------------------------------------
// |    |    |    |    |    |    |                |    |    |    |    |    |        |
// |Rst |    |Qwer|Colmk|   |    |                |    |    |    |    |    |        |
// |    |    |    |    |    |    |                |    |Vol-|Mute|Vol+|    |        |
// |    |    |    |    |    |    |      |        |    |Prev|Play|Next|    |        |
//             |    |    |    |    |      |        |    |    |    |    |    |
&trans     &trans    &trans    &trans    &trans    &trans                  &trans    &trans    &trans    &trans    &trans    &trans
&kp BOOT   &trans    &to 0     &to 1     &trans    &trans                  &trans    &trans    &trans    &trans    &trans    &trans
&trans     &trans    &trans    &trans    &trans    &trans                  &trans    &kp VOLD  &kp C_MUTE &kp VOLU  &trans    &trans
&trans     &trans    &trans    &trans    &trans    &trans    &trans        &trans    &kp PREV  &kp PLAY  &kp NEXT  &trans    &trans
                &trans   &trans   &trans   &trans    &trans                  &trans    &trans   &trans   &trans   &trans
            >;
        };
    };
};
