#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3     &kp N4  &kp N5       &trans  &kp N6     &kp N7  &kp N8     &kp N9    &kp N0    &kp GRAVE
&kp ESC    &kp Q     &kp W     &kp E      &kp R   &kp T        &trans  &kp Y      &kp U   &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A     &kp S     &kp D      &kp F   &kp G        &trans  &kp H      &kp J   &kp K      &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V   &kp B        &trans  &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&trans     &kp LGUI  &kp LALT  &kp LCTRL  &mo 1   &kp ENTER    &trans  &kp SPACE  &mo 2   &kp MINUS  &kp PLUS  &kp RGUI
            >;

            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
&trans     &kp F1     &kp F2     &kp F3    &kp F4    &kp F5       &trans  &kp F6     &kp F7    &kp F8        &kp F9     &kp F10   &kp F11
&kp GRAVE  &kp N1     &kp N2     &kp N3    &kp N4    &kp N5       &trans  &kp N6     &kp N7    &kp N8        &kp N9     &kp N0    &kp F12
&trans     &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT    &trans  &kp CARET  &kp AMPS  &kp ASTERISK  &kp LPAR   &kp RPAR  &kp PIPE
&trans     &kp EQUAL  &kp MINUS  &kp PLUS  &kp LBRC  &kp RBRC     &trans  &kp LBKT   &kp RBKT  &kp SEMI      &kp COLON  &kp BSLH  &trans
&trans     &trans     &trans     &trans    &trans    &trans       &trans  &trans     &trans    &trans        &trans     &trans
            >;

            display-name = "layer1";
        };

        layer_2 {
            bindings = <
&trans  &trans     &trans           &trans              &trans     &trans      &trans  &trans     &trans    &trans        &trans     &trans        &trans
&trans  &kp INS    &kp PRINTSCREEN  &kp K_CONTEXT_MENU  &trans     &trans      &trans  &kp PG_UP  &kp LALT(LEFT)   &kp UP &kp LALT(RIGHT)  &kp LC(BSPC)  &kp BSPC
&trans  &kp LALT   &kp LCTRL        &kp LSHFT           &trans     &kp CAPS    &trans  &kp PG_DN  &kp LEFT  &kp DOWN      &kp RIGHT  &kp DEL       &kp BSPC
&trans  &kp LC(Z)  &kp LC(X)        &kp LC(C)           &kp LC(V)  &trans      &trans  &kp EQUAL  &kp HOME  &kp ASTERISK  &kp END    &kp PRCNT     &trans
&trans  &trans     &trans           &trans              &trans     &trans      &trans  &trans     &trans    &trans        &trans     &trans
            >;

            display-name = "layer2";
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
